{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "new": "hexo new",
    "draft": "hexo new draft",
    "dev": "hexo server --ip 127.0.0.1 --draft",
    "server": "npm run dev",
    "build": "bash bin/build.sh",
    "clean": "hexo clean",
    "test:loading": "node --test test/loading-progress.test.cjs",
    "publish": "bash bin/publish.sh",
    "deploy": "npm run publish",
    "sync": "git pull --ff-only"
  },
  "hexo": {
    "version": "6.2.0"
  },
  "dependencies": {
    "hexo": "^6.2.0",
    "hexo-asset-image": "https://codeload.github.com/CodeFalling/hexo-asset-image/tar.gz/3c114cf0c0343ab28469635085b225fcae7fb9d3",
    "hexo-deployer-git": "^3.0.0",
    "hexo-generator-archive": "^1.0.0",
    "hexo-generator-category": "^1.0.0",
    "hexo-generator-feed": "4.0.0",
    "hexo-generator-index": "^2.0.0",
    "hexo-generator-sitemap": "3.0.1",
    "hexo-generator-tag": "^1.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^5.0.0",
    "hexo-renderer-stylus": "^2.1.0",
    "hexo-server": "^3.0.0",
    "hexo-theme-landscape": "^0.0.3"
  }
}
